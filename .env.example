# Copy to .env and fill in. Never commit .env.

# Huckleberry (source) — same credentials as codmon-huckleberry-sync.
HUCKLEBERRY_EMAIL=your-huckleberry-email@example.com
HUCKLEBERRY_PASSWORD=your-huckleberry-password

# Sprout Track (target) — self-hosted instance reachable over HTTP(S).
SPROUT_BASE_URL=https://sprout-track.example.com
# One or more API keys (comma/space separated). Create them in the main app:
# Settings > Admin > Integrations (admin role, NOT the Family Manager). Keys
# look like st_live_<hex> and are shown once. Each key has its own 30
# writes/min budget, so adding keys multiplies write throughput — a full
# multi-year backfill at ~30/min takes hours; with more keys it's Nx faster.
SPROUT_API_KEYS=st_live_your_key_here st_live_key2 st_live_key3
# Optional: a baby-scoped key seals this; otherwise the first baby returned by
# GET /api/hooks/v1/babies is used. Discover ids with `hb-st-sync sprout-info`.
#SPROUT_BABY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# IANA timezone (default Asia/Tokyo)
TIMEZONE=Asia/Tokyo

# When true, planned webhook payloads are printed but nothing is written.
DRY_RUN=true

# Child to read on the Huckleberry side (name or nickname token).
# Default: first child on the account. Use a shared token, e.g. CHILD=BABY.
#CHILD=BABY

# Which Huckleberry record types to sync into Sprout Track.
SYNC_FEED=true
SYNC_SLEEP=true
SYNC_DIAPER=true
SYNC_ACTIVITY=true
SYNC_TEMPERATURE=true
SYNC_PUMP=true
SYNC_GROWTH=true
# Medication only syncs names already configured in Sprout Track (Settings ->
# Medicines); unknown names are skipped.
SYNC_MEDICATION=true

# Volume unit to push for bottle/pump amounts. Must be configured for your
# Sprout Track family (GET /reference?type=units). ML or OZ. When unset, ML is
# preferred if configured, otherwise the family's first unit. Amounts are
# converted from Huckleberry's stored unit (1 fl oz = 29.5735 ml).
#SPROUT_UNIT=ML

# Sprout Track sleeps have no explicit end time in POST; a sleep is sent with
# its start time + duration (minutes). Sleeps that START at or after this hour
# (local time) are typed NIGHT_SLEEP, earlier ones NAP.
NIGHT_START_HOUR=20

# Dedup: a Sprout Track activity already present within this many minutes of a
# planned event's time counts as already-synced.
#DEDUP_WINDOW_MINUTES=15

# How far back to query Sprout Track when collecting existing activities for
# dedup, relative to the earliest day being synced.
#DEDUP_SINCE_DAYS=7

# Minimum pause between Sprout Track POSTs (POST/PUT/DELETE share a 30/min
# rate limit). The client re-reads X-RateLimit-* and backs off on 429.
#WRITE_DELAY_SECONDS=2.2

# Optional Apprise webhook endpoint for push notifications after each sync.
# Leave unset to disable.
#APPRISE_URL=https://apprise.example.example/notify/huckleberry-sprouttrack-sync